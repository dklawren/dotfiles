//-*- mode: jsonc -*-
{
    "layer": "top", 
    "position": "top", 
    "height": 30, 
    "spacing": 4, 

    // Choose the order of the modules
    "modules-left": [
        "sway/workspaces",
        "custom/sep",
        "sway/window",
        "custom/sep"
    ],
    "modules-center": [
        "clock"
    ],

    "modules-right": [
	"custom/sep",
	"battery",
        "custom/sep",
        "network",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "disk",
        "custom/sep",
        "tray"
	//"clock",
	//"custom/sep"
    ],

    // Modules configuration
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*" : 9
        }
    },
    "sway/window" : {
        "max-length": 40,
        "seperate-outputs": false
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },
    "memory": {
        "intereval": 30,
        "format": "Mem: {percentage}%",
        "tooltip": true,
        "tooltip-format": "Used: {used}GB / Total: {total}GB",
    },
    "disk": {
        "interval": 60,
        "path": "/",
        "format": "Disk: {free}"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "Bat: {capacity}%",
        "format-plugged": "{capacity}% plg",
        "format-alt": "Bat {capacity}%",
        "format-time": "{H}:{M}"
    },
    "network": {
	"format": "Disconnected",
        "format-wifi": "WiFi: {essid} ({signalStrength}%)",
	"format-ethernet": "Eth: {ipaddr}/{cidr}",
        "format-disconnected": "Disconnected",
	"interval": 1
    },
    "custom/sep": {
        "format" : "|",
        "interval" : 0
    }
}

_default:
  just -l

check:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "🔍 Validating Neovim config (including plugins)..."
	OUTPUT=$(nvim --headless -c "lua vim.print('NVIM_CONFIG_OK')" -c "quitall!" 2>&1) || true
	if echo "$OUTPUT" | grep -q "NVIM_CONFIG_OK" && ! echo "$OUTPUT" | grep -qE "(Error|E[0-9]+:|Failed)"; then
		echo "✅ Config and plugins are valid"
	else
		echo "❌ Config has errors:"
		echo "$OUTPUT"
		exit 1
	fi

# Lint Lua with lua-language-server, using this repo's .luarc.json.
# VIMRUNTIME is exported because .luarc.json refers to it; nvim sets it for the
# in-editor server, but not for this CLI run.
lint:
	@echo "Linting Lua files..."
	@VIMRUNTIME="$(nvim --headless -c 'echo $VIMRUNTIME' -c quit 2>&1)" \
		lua-language-server --check . --checklevel=Warning --logpath="$(mktemp -d)"
	@echo "✅ Lint clean!"

test-format:
	@bash tests/format_test.sh

fmt:
	@echo "Formatting Lua files..."
	@stylua .
	@echo "✅ Formatting complete"

fmt-check:
	@echo "Checking code formatting..."
	@stylua --check .
	@echo "✅ Formatting valid!"

validate: check fmt-check lint

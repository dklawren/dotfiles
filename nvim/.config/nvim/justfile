	@bash tests/blink_test.sh

test-scroll:
	@bash tests/scroll_test.sh

# Every suite in tests/, and the static readings, in one command.
#
# The per-suite targets above are for working on one thing. This is the one to
# run before committing, because a suite that is not in the list is a suite that
# is not a gate: picker_test.sh had 227 checks and no target here at all, so
# nothing a developer ran would have told them whether it still passed.
#
# lint-lua is separate from `lint` on purpose. `lint` is lua-language-server
# over everything, which takes about a minute and cannot be scoped. lint-lua is
# luacheck over lua/ in a fraction of a second, and it catches the class of
# mistake no behaviour test can see: a name used in a function before the local
# that holds it is declared is a global, and a global that happens to be nil
# formats into a string as the text "nil" rather than complaining.
test: test-session test-picker test-markdown test-buffer test-mcursor test-pairs test-pack test-statusline test-cloak test-jump test-codeaction test-filetype test-plugins test-fold test-format test-blink test-scroll test-draw lint-lua
	@echo "✅ All suites passed"

# Skipped, not failed, when luacheck is not installed: a machine without it has
# no opinion, and reporting a failure for a tool that is absent would train
# people to ignore this.
lint-lua:
	@if command -v luacheck >/dev/null 2>&1; then \
		luacheck lua/ --globals vim --no-color --no-max-line-length --ignore 4; \
	else \
		echo "luacheck not installed, skipping"; \
	fi

fmt:
	@echo "Formatting Lua files..."
	@stylua .
	@echo "✅ Formatting complete"

fmt-check:
	@echo "Checking code formatting..."
	@stylua --check .
	@echo "✅ Formatting valid!"

validate: check fmt-check lint test

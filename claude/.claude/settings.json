{
  "enabledPlugins": {
    "adhd-output-style@claude-settings": true,
    "eli5@claude-community": true,
    "fastly-waf@internal-aidev-plugins": true,
    "github-dev@claude-settings": true,
    "humanize@claude-settings": true,
    "i-have-adhd@i-have-adhd": true,
    "paad@paad": true,
    "simplify@claude-settings": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "repo": "anthropics/claude-plugins-community",
        "source": "github"
      }
    },
    "claude-settings": {
      "source": {
        "repo": "fcakyon/claude-codex-settings",
        "source": "github"
      }
    },
    "i-have-adhd": {
      "source": {
        "repo": "ayghri/i-have-adhd",
        "source": "github"
      }
    },
    "internal-aidev-plugins": {
      "source": {
        "repo": "mozilla/internal-aidev-plugins",
        "source": "github"
      }
    },
    "paad": {
      "source": {
        "repo": "Ovid/paad",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status waiting",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"/usr/bin/node\" \"/home/dkl/.claude/hooks/caveman-activate.js\"",
            "statusMessage": "Loading caveman mode...",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "workmux register-agent",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|fork"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"/usr/bin/node\" \"/home/dkl/.claude/hooks/caveman-mode-tracker.js\"",
            "statusMessage": "Tracking caveman mode...",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "foxtail",
    "padding": 0,
    "type": "command"
  }
}

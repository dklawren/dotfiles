#!/bin/bash

alias ls='eza --icons=always --group-directories-first'
alias la='eza --all --icons=always --group-directories-first'
alias ll='eza --long --all --git --icons=always --group-directories-first'
alias tree='eza --tree --icons'

# Use rg instead of grep
alias grep='rg --color=auto'

# Lazygit shortcut
alias lg='lazygit'

# Worktrunk
alias wts='wt switch'
alias wtl='wt list'
alias wtc='wt switch -c'

# Dotfile management
alias config='git --git-dir=$HOME/.dotfiles --work-tree=$HOME'

# BMO localhost fix
alias bmo-local='patch -p1 < $HOME/devel/patches/localhost_8000.patch'
alias bmo-unlocal='patch -p1 -R < $HOME/devel/patches/localhost_8000.patch'

# Various Neovim configurations
alias nvim-lazy="NVIM_APPNAME=LazyVim nvim"
alias nvim-kick="NVIM_APPNAME=kickstart nvim"
alias nvim-chad="NVIM_APPNAME=NvChad nvim"
alias nvim-astro="NVIM_APPNAME=AstroNvim nvim"

# debian specific aliases
alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="z .."
alias ...="z ../.."
alias ....="z ../../.."
alias .....="z ../../../.."
alias ~="z ~" # `cd` is probably faster to type though
alias -- -="z -"

# Shortcuts
alias cd=z
alias dl="cd ~/Downloads"
alias h="history"
alias vi='nvim'
alias dmux="ssh -t docker tmux new -A"
alias cat=bat
alias t="tmux attach -t default || tmux new -s default && exit"

# Docker
alias d=docker
alias dx='docker exec -it'
alias dc='docker compose'
alias da='docker ps -q -a'
alias dv='docker volume ls -q'

# Podman
alias pm=podman
alias pmx='podman exec -it'
alias pmc=podman-compose
alias pma='podman ps -q -a'
alias pmv='podman volume ls -q'

# Git
alias g=git
alias gup='git stash; git pull --rebase; git stash pop'
alias gstat='git status'
alias gdiff='git diff'
alias gwt='git worktree'

# Mercurial
alias hup='hg pull -u'
alias hstat='hg status'
alias hdiff='hg diff'

# Python
alias venv='python3 -m virtualenv venv; source venv/bin/activate'
alias ve='virtualenv-3.6 ./venv'
alias ae='source ./venv/bin/activate'
alias de='deactivate'

# List all files colorized in long format
alias l="eza -lF --color"

# List all files colorized in long format, including dot files
alias ls='eza --icons=always --group-directories-first'
alias la='eza --all --icons=always --group-directories-first'
alias ll='eza --long --all --git --icons=always --group-directories-first'
alias tree='eza --tree --icons'

# List only directories
alias lsd="eza -lF --color | grep --color=never '^d'"

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Get week number
alias week='date +%V'

# Stopwatch
alias timer='echo "Timer started. Stop with Ctrl-D." && date && time cat && date'

# IP addresses
alias pubip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="sudo ifconfig | grep -Eo 'inet (addr:)?([0-9]*\.){3}[0-9]*' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '127.0.0.1'"
alias ips="sudo ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Flush Directory Service cache
alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"

# View HTTP traffic
alias sniff="sudo ngrep -d 'en1' -t '^(GET|POST) ' 'tcp and port 80'"
alias httpdump="sudo tcpdump -i en1 -n -s 0 -w - | grep -a -o -E \"Host\: .*|GET \/.*\""

# Trim new lines and copy to clipboard
alias c="tr -d '\n' | xclip -selection clipboard"

# URL-encode strings
alias urlencode='python -c "import sys, urllib as ul; print ul.quote_plus(sys.argv[1]);"'

# Merge PDF files
# Usage: `mergepdf -o output.pdf input{1,2,3}.pdf`
alias mergepdf='/System/Library/Automator/Combine\ PDF\ Pages.action/Contents/Resources/join.py'

# Intuitive map function
# For example, to list all directories that contain a certain file:
# find . -name .gitattributes | map dirname
alias map="xargs -n1"

# One of @janmoesen’s ProTip™s
for method in GET HEAD POST PUT DELETE TRACE OPTIONS; do
	alias "$method"="lwp-request -m '$method'"
done

# vhosts
alias hosts='sudo /usr/bin/vi /etc/hosts'

# copy working directory
alias cwd='pwd | tr -d "\r\n" | xclip -selection clipboard'

# copy file interactive
alias cp='cp -i'

# move file interactive
alias mv='mv -i'

# untar
alias untar='tar xvf'

# make the dir command work kinda like in windows (long format)
alias dir='eza --color=auto -l'

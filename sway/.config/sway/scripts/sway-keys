#!/usr/bin/env bash
# Show KEYBOARD.md in a floating, scrollable ghostty window (toggle: run again to close).
# Esc is mapped to "q" for this window only, so less quits on Esc (arrows unaffected).
# Errors are logged to $XDG_RUNTIME_DIR/sway-keys.log.
if pgrep -f 'class=dev.dkl.swaykeys' >/dev/null; then
  pkill -f 'class=dev.dkl.swaykeys'; exit 0
fi
cd ~ || exit 1  # PATH may contain "." and ~/.dotfiles has a ghostty/ dir
exec ghostty --class=dev.dkl.swaykeys --gtk-single-instance=false --keybind=escape=text:q --title="Keyboard shortcuts" \
  -e bash -c '
f=~/.config/sway/KEYBOARD.md
style=~/.config/sway/glow-gruvbox.json
log=${XDG_RUNTIME_DIR:-/tmp}/sway-keys.log
: > "$log"
export PAGER="less -R"
{ glow -p -s "$style" -w 0 "$f" 2>>"$log" \
  || bat --paging=always --style=plain --language=markdown "$f" 2>>"$log" \
  || less "$f"; } || { cat "$log"; read -n1 -p "Press any key to close"; }'

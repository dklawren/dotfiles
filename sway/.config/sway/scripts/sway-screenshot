#!/usr/bin/env bash
# sway-screenshot area|screen|window|edit
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"; mkdir -p "$dir"
f="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case "$1" in
  area)   g=$(slurp -d -b '#28282880' -c '#83a598' -w 2) || exit 0; grim -g "$g" "$f" ;;
  screen) grim "$f" ;;
  window) g=$(swaymsg -t get_tree | jq -r '.. | select(.focused?==true) | "\(.rect.x),\(.rect.y) \(.rect.width)x\(.rect.height)"') ; grim -g "$g" "$f" ;;
  edit)   g=$(slurp -d) || exit 0; grim -g "$g" - | swappy -f - -o "$f"; [ -f "$f" ] || exit 0 ;;
  *) exit 1 ;;
esac
wl-copy < "$f"
notify-send -i "$f" "Screenshot saved" "$(basename "$f")"

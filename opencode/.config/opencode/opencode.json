{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "mcp": {
    "todoist": {
      "type": "local",
      "command": [
        "npx",
        "@greirson/mcp-todoist"
      ],
      "environment": {
        "TODOIST_API_TOKEN": "e306ac3352b6a5654344f9052a5fee8cd2aab2bd"
      }
    },
    "silverbullet": {
      "type": "remote",
      "url": "http://127.0.0.1:3999/.mcp"
    },
    "mindwtr": {
      "type": "local",
      "command": ["npx", "-y", "mindwtr-mcp", "--db", "/home/dkl/.local/share/mindwtr/mindwtr.db", "--write"]
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3:8b-16k": { "name": "Qwen3 8B (16k)" }
      }
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "mcp": {
    "silverbullet": {
      "type": "local",
      "command": ["npx", "-y", "silverbullet-ai-mcp"],
      "environment": { "SB_URL": "desktop" }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3:8b-16k": { "name": "Qwen3 8B (16k)" }
      }
    }
  }
}

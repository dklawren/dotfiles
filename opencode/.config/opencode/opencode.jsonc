{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "mcp": {
    "silverbullet": {
      "type": "remote",
      "url": "http://127.0.0.1:3999/.mcp",
      "enabled": true
    },
    "todoist": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp",
      "enabled": true
    }
  },
